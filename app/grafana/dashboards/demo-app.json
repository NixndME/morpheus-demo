{
 "uid": "demo-app",
 "title": "Demo App",
 "timezone": "browser",
 "refresh": "10s",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Database",
   "datasource": {
    "type": "prometheus",
    "uid": "demo-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "min(mysql_up{job=\"mysql\"}) or on() vector(0)",
     "instant": true
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Down",
         "color": "red"
        },
        "1": {
         "text": "Up",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Database VM",
   "datasource": {
    "type": "prometheus",
    "uid": "demo-prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "min(up{job=\"db\"}) or on() vector(0)",
     "instant": true
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Down",
         "color": "red"
        },
        "1": {
         "text": "Up",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "App connections",
   "datasource": {
    "type": "prometheus",
    "uid": "demo-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(mysql_global_status_threads_connected{job=\"mysql\"})",
     "instant": true
    }
   ],
   "options": {
    "colorMode": "none",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "alertlist",
   "title": "Alerts",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 5
   },
   "options": {
    "viewMode": "list",
    "groupMode": "default",
    "maxItems": 10,
    "sortOrder": 1,
    "dashboardAlerts": false,
    "alertName": "",
    "alertInstanceLabelFilter": "",
    "stateFilter": {
     "firing": true,
     "pending": true,
     "normal": true
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "CPU used",
   "datasource": {
    "type": "prometheus",
    "uid": "demo-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 - avg by (tier) (rate(node_cpu_seconds_total{mode=\"idle\",tier!=\"\"}[1m])) * 100",
     "legendFormat": "{{tier}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Memory used",
   "datasource": {
    "type": "prometheus",
    "uid": "demo-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(1 - node_memory_MemAvailable_bytes{tier!=\"\"} / node_memory_MemTotal_bytes{tier!=\"\"}) * 100",
     "legendFormat": "{{tier}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Database queries per second",
   "datasource": {
    "type": "prometheus",
    "uid": "demo-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(mysql_global_status_queries{job=\"mysql\"}[1m]))",
     "legendFormat": "queries"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Network in",
   "datasource": {
    "type": "prometheus",
    "uid": "demo-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tier) (rate(node_network_receive_bytes_total{device!=\"lo\",tier!=\"\"}[1m]))",
     "legendFormat": "{{tier}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  }
 ],
 "tags": [
  "morpheus-demo"
 ]
}